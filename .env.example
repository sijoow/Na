# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 git 에 올라가지 않아요)
# Vercel 에서는 Project → Settings → Environment Variables 에 같은 이름으로 넣으면 돼요.

# MongoDB Atlas 연결 문자열. 비워 두면 로컬 파일 data/trip.json 에 저장해요.
# 예) mongodb+srv://사용자:비밀번호@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=

# (로컬 PC 전용) mongodb+srv 주소의 DNS 조회가 "querySrv ECONNREFUSED" 로 실패할 때 쓸 DNS 서버, 콤마로 구분. 배포(Vercel)에서는 비워 두세요.
MONGODB_DNS_SERVERS=

# 데이터베이스 이름 (비워 두면 nhatrang_planner)
MONGODB_DB=nhatrang_planner

# trips 컬렉션 안의 여행 문서 _id (비워 두면 nhatrang-2026). 여행을 새로 만들 때만 바꾸세요.
TRIP_ID=nhatrang-2026

# 가족 공유용 비밀번호. 비워 두면 잠금 없이 누구나 열 수 있어요. 바꾸면 모든 기기에서 다시 로그인해야 해요.
APP_PASSCODE=

# 'AI에게 물어보기' 탭용 Anthropic API 키 (console.anthropic.com → API Keys). 비워 두면 AI 탭만 안 돼요.
# 넣거나 바꾼 뒤에는 개발 서버(npm run dev)를 다시 켜야 반영돼요.
ANTHROPIC_API_KEY=

# (선택) AI 탭 모델. 비워 두면 src/app/api/ask/route.ts 의 기본 모델을 써요.
AI_MODEL=
